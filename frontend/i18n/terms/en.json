 "concepts": {
  "transfer": {"en": "Transfer", "note": "One requested item, from submission through download to completion. Not 'job' or 'task'. English also uses 'transfer' as a verb, so it has no match: a termbase lists the forbidden alternatives."},
  "downloads_page": {"en": "Downloads", "key": "shell.nav.downloads", "note": "The page that lists transfers."},
  "premium_services": {"en": "Premium Services", "key": "settings.services.premium", "match": "\\bpremium services?\\b", "note": "AllDebrid, Debrid-Link, Premiumize, Real-Debrid, TorBox."},
  "network_sources": {"en": "Network Sources", "key": "integration.group.direct_sources", "match": "\\bnetwork sources?\\b", "note": "HTTP & HTTPS, FTP & SFTP, SCP, rsync, WebDAV, Multimeta, Media Downloads."},
  "role_admin": {"en": "Admin", "key": "role.admin", "match": "\\bAdmins?\\b", "note": "Role name; translate once and reuse. Never the API's role identifier."},
