  "role_readonly": {"en": "ReadOnly User", "key": "role.readonly", "match": "\\bReadOnly\\b", "flags": "u", "note": "Role name."},
  "role_integration": {"en": "Integration", "key": "role.integration", "note": "Role of an API-token account. 'Integration' also names services in English, so it has no match."},
  "display_name": {"en": "Display Name", "key": "account.field.display_name", "match": "\\bdisplay names?\\b", "note": "What the interface calls the person; distinct from the actual name."},
  "actual_name": {"en": "Actual Name", "key": "account.field.actual_name", "match": "\\bactual names?\\b", "note": "The person's real name; never shown in the sidebar."},
  "my_account": {"en": "My Account", "key": "session.my_account", "match": "\\bMy Account\\b", "flags": "u", "note": "The person's own profile dialog."},
  "sign_in": {"en": "Sign In", "key": "login.sign_in", "note": "Start a browser session."},
  "log_out": {"en": "Log Out", "key": "session.log_out", "note": "End a browser session."},
  "easy": {"en": "Easy", "key": "presentation.easy", "match": "\\bEasy\\b", "flags": "u", "note": "Per-account presentation that omits listed parts; it never grants anything."},
  "advanced": {"en": "Advanced", "key": "presentation.advanced", "match": "\\bAdvanced\\b(?! Settings)", "flags": "u", "note": "The full presentation the role and deployment permit (not the Advanced Settings disclosures)."},
  "server": {"en": "Server", "key": "settings.deployment.server", "note": "Deployment type: many accounts. 'Server' also names news servers in English, so it has no match."},
  "standalone": {"en": "Standalone", "key": "settings.deployment.standalone", "match": "\\bStandalone\\b", "flags": "u", "note": "Deployment type: one person."},
  "help_license": {"en": "Help & License", "key": "shell.nav.help", "match": "Help & License", "flags": "u", "note": "Product guide and licensing page."},
  "field_manual": {"en": "Field Manual", "key": "help.header.title", "match": "\\bField Manual\\b", "flags": "u", "note": "The Help page's own name."},
  "activity_log": {"en": "Activity Log", "key": "shell.nav.activity_log", "match": "\\bActivity Log\\b", "flags": "u", "note": "Transfer events, decisions and alerts."},
  "download_activity": {"en": "Download Activity", "key": "dashboard.activity.title", "match": "\\bDownload Activity\\b", "flags": "u", "note": "Locked DebridPulse term: the Dashboard's live list."},
  "download_engine_activity": {"en": "Download Engine Activity", "key": "settings.engine_activity.title", "match": "\\bDownload Engine Activity\\b", "flags": "u", "note": "The Settings card listing engine work."},
  "dashboard": {"en": "Dashboard", "key": "shell.nav.dashboard", "note": "Page name."},
  "settings": {"en": "Settings", "key": "shell.nav.settings", "note": "Page name."},
  "statistics": {"en": "Statistics", "key": "shell.nav.statistics", "note": "Page name."},
  "restore_point": {"en": "restore point", "match": "\\brestore points?\\b", "note": "A saved copy of configuration and database."},
  "provider": {"en": "Provider", "key": "root_provider.title", "note": "The service that resolves a source (premium service, Usenet, network source); distinct from Source."},
  "source": {"en": "Source", "key": "group_candidates.source", "note": "Where a file comes from; distinct from Provider."},
  "retry": {"en": "Retry", "key": "transfer.action.retry", "note": "Try again after a failure; distinct from Resume and Recovery."},
  "resume": {"en": "Resume", "key": "transfer.action.resume", "note": "Continue after a pause; distinct from Retry and Recovery."},
  "recovery": {"en": "Recovery", "key": "activity.category.recovery", "note": "DebridPulse's own handling after a fault; distinct from Retry and Resume."}
 }
