# DownloadPulse's aria2 for Windows x64, built on the same pinned Debian base as
# the Linux package (packaging/aria2/Dockerfile) with Debian's mingw-w64 cross
# toolchain and Debian's signed source packages. Build context: the repository
# root.
#   podman build -f packaging/aria2/Dockerfile.windows -o <out-dir> .
FROM python:3.12.14-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS build
ARG ARIA2_SOURCE_VERSION=1.37.0+debian-3
COPY packaging/aria2/ /dp/aria2/
RUN set -eux; \
    sed -ri 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends dpkg-dev make patch gcc libc6-dev perl \
      pkg-config autoconf automake autopoint libtool gettext \
      gcc-mingw-w64-x86-64-win32 g++-mingw-w64-x86-64-win32 binutils-mingw-w64-x86-64; \
    ARIA2_SOURCE_VERSION="${ARIA2_SOURCE_VERSION}" bash /dp/aria2/build-windows.sh /build /out; \
    cd /out; find bin source -type f | sort | xargs sha256sum > SHA256SUMS

FROM scratch
COPY --from=build /out/ /
