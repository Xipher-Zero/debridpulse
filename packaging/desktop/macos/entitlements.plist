<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened-runtime exceptions DownloadPulse's bundled code needs, nothing more:
     deno's V8 generates code (JIT); the bundled Python loads the locked wheels'
     extension modules, signed by this identity but built by others. Not the App
     Sandbox: Media Downloads helpers are confined by their own Seatbelt profile. -->
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
