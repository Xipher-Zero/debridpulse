@@ -1,4 +1,5 @@
 #include <string>
+#include <future>
 #include <iostream>
 #include <filesystem>
 #include <regex>
@@ -71,6 +72,29 @@ using namespace Gdiplus;
 namespace window {
 
 webview::webview *nativeWindow;
+
+#if defined(__linux__) || defined(__FreeBSD__)
+void runOnMainThread(const std::function<void()> &f) {
+    // GTK and GDK are not thread-safe: every call that touches the window
+    // runs on the thread that owns the default main context (gtk_main).
+    if(!nativeWindow || g_main_context_is_owner(g_main_context_default())) {
+        f();
+        return;
+    }
+    std::promise<void> done;
+    std::future<void> ran = done.get_future();
+    nativeWindow->dispatch([&f, &done]() {
+        try {
+            f();
+            done.set_value();
+        }
+        catch(...) {
+            done.set_exception(std::current_exception());
+        }
+    });
+    ran.get();
+}
+#endif
 #if defined(__linux__) || defined(__FreeBSD__)
 bool isGtkWindowFullScreen = false;
 bool isGtkWindowMinimized = false;
