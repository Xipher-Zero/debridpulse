+// DownloadPulse: {"caption": "#RRGGBB", "dark": bool} -- the frame's colour and
+// appearance (window::setFrameTheme).
+json setFrameTheme(const json &input) {
+    json output;
+    if(!helpers::hasField(input, "caption")) {
+        output["error"] = errors::makeMissingArgErrorPayload("caption");
+        return output;
+    }
+    string caption = input["caption"].get<string>();
+    if(caption.size() != 7 || caption[0] != '#' ||
+            caption.find_first_not_of("0123456789abcdefABCDEF", 1) != string::npos) {
+        output["error"] = errors::makeMissingArgErrorPayload("caption");
+        return output;
+    }
+    bool dark = helpers::hasField(input, "dark") && input["dark"].get<bool>();
+    auto channel = [&](int at) { return stoi(caption.substr(at, 2), nullptr, 16) / 255.0; };
+    window::setFrameTheme(channel(1), channel(3), channel(5), dark);
+    output["success"] = true;
+    return output;
+}
