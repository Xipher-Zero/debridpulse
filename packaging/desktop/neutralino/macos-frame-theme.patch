+// DownloadPulse: the window's frame in the application's theme. macOS: the title
+// bar drawn transparent over the window background, which is the theme's frame
+// colour, in the theme's appearance (dark or light) -- the traffic lights and
+// dragging stay the system's own. Elsewhere nothing (Windows' frame is
+// coloured by the DownloadPulse supervisor; Linux keeps its desktop's frame).
+void setFrameTheme(double red, double green, double blue, bool dark) {
+    #if defined(__APPLE__)
+    id window = (id) windowHandle;
+    ((void (*)(id, SEL, BOOL))objc_msgSend)(window, "setTitlebarAppearsTransparent:"_sel, YES);
+    id color = ((id (*)(id, SEL, CGFloat, CGFloat, CGFloat, CGFloat))objc_msgSend)(
+        "NSColor"_cls, "colorWithSRGBRed:green:blue:alpha:"_sel, red, green, blue, 1.0);
+    ((void (*)(id, SEL, id))objc_msgSend)(window, "setBackgroundColor:"_sel, color);
+    id name = ((id (*)(id, SEL, const char *))objc_msgSend)(
+        "NSString"_cls, "stringWithUTF8String:"_sel, dark ? "NSAppearanceNameDarkAqua" : "NSAppearanceNameAqua");
+    id appearance = ((id (*)(id, SEL, id))objc_msgSend)("NSAppearance"_cls, "appearanceNamed:"_sel, name);
+    ((void (*)(id, SEL, id))objc_msgSend)(window, "setAppearance:"_sel, appearance);
+    #endif
+}
