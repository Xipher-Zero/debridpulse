+#if defined(__APPLE__)
+void __watchSignal(int signum) {
+    signal(signum, SIG_IGN);
+    dispatch_source_t source = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, signum, 0,
+                                                      dispatch_get_main_queue());
+    dispatch_source_set_event_handler(source, ^{
+        app::exit(128 + signum);
+    });
+    dispatch_resume(source);
+}
+#endif
+
 void __registerCleanupHandlers() {
+    #if defined(__APPLE__)
+    __watchSignal(SIGINT);
+    __watchSignal(SIGTERM);
+    #else
     signal(SIGINT, __signalHandler);
     signal(SIGTERM, __signalHandler);
+    #endif
     #if defined(_WIN32)
     signal(SIGABRT, __signalHandler);
     SetConsoleCtrlHandler(__consoleCtrlHandler, TRUE);
