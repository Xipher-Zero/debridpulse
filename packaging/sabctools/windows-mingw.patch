-    *(void**)&SSL_get_shutdown = GetProcAddress(openssl_handle, "SSL_get_shutdown");
+    *(void**)&SSL_read_ex = (void*)GetProcAddress(openssl_handle, "SSL_read_ex");
+    *(void**)&SSL_get_error = (void*)GetProcAddress(openssl_handle, "SSL_get_error");
+    *(void**)&SSL_get_shutdown = (void*)GetProcAddress(openssl_handle, "SSL_get_shutdown");
 #else
