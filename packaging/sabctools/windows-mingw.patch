Windows (mingw-w64) build of sabctools, applied by packaging/sabctools/build-windows.sh only:
  - link: no libdl (sabctools dlopen()s OpenSSL only on POSIX; on Windows
    src/unlocked_ssl.h takes the _WIN32 LoadLibrary/GetProcAddress path), and
    Winsock (ws2_32) after the objects that use it, which an MSVC build gets
    through its default libraries;
  - <Windows.h> is spelled <windows.h>: the header's name in mingw-w64, which
    a case-sensitive build host requires (Windows itself ignores case);
  - GetProcAddress results are cast to void* explicitly, which MSVC does
    implicitly and GCC requires (same meaning).
--- a/setup.py	2026-08-02 23:51:03.000000000 -0700
+++ b/setup.py	2026-11-14 00:20:14.513826480 -0700
@@ -119,7 +119,7 @@
                 log.info("==> C++17 flag not available")
         else:
             # TODO: consider -flto - may require some extra testing
-            ldflags = ["-ldl"]  # for dlopen
+            ldflags = []  # Windows: LoadLibrary (src/unlocked_ssl.h), no libdl
             cflags = [
                 "-Wall",
                 "-Wextra",
@@ -383,7 +383,7 @@
             compiled_objects += self.compiler.object_filenames(source_files["sources"], output_dir=output_dir)
 
         # attach to Extension
-        ext.extra_link_args = ldflags + compiled_objects
+        ext.extra_link_args = ldflags + compiled_objects + ["-lws2_32"]  # Winsock, after its users
         ext.depends = ["src/sabctools.h"] + compiled_objects
 
         # proceed with regular Extension build
--- a/src/sparse.h	2026-08-02 23:51:03.000000000 -0700
+++ b/src/sparse.h	2026-11-14 00:15:30.526823697 -0700
@@ -22,7 +22,7 @@
